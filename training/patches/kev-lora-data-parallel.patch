+def replicate(model):
+    """Data-parallel LoRA: every rank trains the whole (small) adapter and pointer head, starting from rank 0's copy;
+    sum_gradients makes their updates identical."""
+    for t in model.trainable_parameters(): dist.broadcast(t.data, 0)
+
+
+def sum_gradients(params):
+    """Data-parallel LoRA: each rank's gradients summed over the ranks, in one flat all-reduce. Summed, not averaged:
+    the trainer divides each micro-batch's loss by the step's global record count, as for FSDP2 (shard)."""
+    grads = [p.grad for p in params if p.grad is not None]
+    flat = torch.cat([g.reshape(-1) for g in grads])
+    dist.all_reduce(flat)
+    offset = 0
+    for g in grads:
+        g.copy_(flat[offset:offset + g.numel()].view_as(g)); offset += g.numel()
+
+
