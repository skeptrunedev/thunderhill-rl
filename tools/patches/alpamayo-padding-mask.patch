diff --git a/alpamayo1_x_rl/models/expert_model/padding_mask.py b/alpamayo1_x_rl/models/expert_model/padding_mask.py
new file mode 100644
index 0000000..e8a422e
--- /dev/null
+++ b/alpamayo1_x_rl/models/expert_model/padding_mask.py
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Keep actual prompt padding excluded from both prefill and expert KV attention."""
+
+import torch
+
+
+def prompt_mask(input_ids: torch.Tensor, attention_mask: torch.Tensor | None) -> torch.Tensor:
+    if attention_mask is None:
+        return torch.ones_like(input_ids, dtype=torch.bool)
+    if attention_mask.shape != input_ids.shape or attention_mask.ndim != 2:
+        raise ValueError("Prompt padding mask must match the input token grid")
+    return attention_mask.to(device=input_ids.device, dtype=torch.bool)
+
+
+def extend_prompt_mask(mask: torch.Tensor, total_length: int) -> torch.Tensor:
+    if mask.ndim != 2 or total_length < mask.shape[1]:
+        raise ValueError("KV prefix cannot be shorter than the prompt mask")
+    return torch.cat((mask, mask.new_ones((mask.shape[0], total_length - mask.shape[1]))), dim=1)
+
+
+def mask_expert_prefix(attention_mask: torch.Tensor, prefix_mask: torch.Tensor) -> torch.Tensor:
+    """Preserve native suffix/block masks; exclude only padded cached keys."""
+    if (attention_mask.ndim != 4 or prefix_mask.ndim != 2
+            or attention_mask.shape[0] != prefix_mask.shape[0]
+            or attention_mask.shape[-1] < prefix_mask.shape[-1]):
+        raise ValueError("Expert attention and cached prefix mask shapes disagree")
+    attention_mask[..., :prefix_mask.shape[-1]].masked_fill_(
+        ~prefix_mask[:, None, None, :].to(device=attention_mask.device, dtype=torch.bool),
+        torch.finfo(attention_mask.dtype).min,
+    )
+    return attention_mask
