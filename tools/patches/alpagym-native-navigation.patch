@@ -0,0 +1,35 @@
+"""Route geometry to native Alpamayo navigation text (Thunderhill adapter)."""
+
+import math
+from typing import Any
+
+
+def navigation_instruction(route_xy: Any) -> str:
+    """Thunderhill adapter: express submitted road geometry as native 1.5 navigation text.
+
+    This is a route instruction, never a racing line or target action. NaN padding
+    follows the AlpaGym route contract. Every rollout and replay uses this function.
+    """
+    rows = route_xy.detach().to(device="cpu").reshape(-1, 2).tolist()
+    points = [(x, y) for x, y in rows if math.isfinite(x) and math.isfinite(y)]
+    if len(points) < 2:
+        raise ValueError("Navigation conditioning requires at least two route points")
+    segments = []
+    distance = 0.0
+    for first, second in zip(points, points[1:]):
+        dx, dy = second[0] - first[0], second[1] - first[1]
+        length = math.hypot(dx, dy)
+        if length > 0.01:
+            segments.append((distance, math.atan2(dy, dx)))
+        distance += length
+    if not segments:
+        raise ValueError("Navigation conditioning requires a nondegenerate route")
+    initial_heading = segments[0][1]
+    for distance, heading in segments[1:]:
+        delta = math.atan2(math.sin(heading - initial_heading), math.cos(heading - initial_heading))
+        if abs(delta) >= math.radians(15):
+            direction = "left" if delta > 0 else "right"
+            return f"Follow the road as it curves {direction} in {round(distance)} m."
+    return "Continue following the road ahead."
+
+
