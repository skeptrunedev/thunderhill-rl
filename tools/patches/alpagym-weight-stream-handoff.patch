+# SPDX-License-Identifier: Apache-2.0
+"""Carry the native Cosmos weight-copy fence into AlpaGym inference."""
+
+import torch
+
+
+def wait_for_weight_updates(source: torch.cuda.Stream) -> None:
+    """Order default-stream inference after native copies without blocking CPU.
+
+    Pinned AlpaGym engine and gRPC threads use the shared per-device default
+    stream. Cosmos supplies a dedicated stream already waiting for its P2R
+    copy completion event. Preserve that dependency before submitting sessions.
+    This does not synchronize the device or change execution backends.
+    """
+    if not isinstance(source, torch.cuda.Stream):
+        raise TypeError("Native CUDA rollout requires the Cosmos inference stream")
+    torch.cuda.default_stream(source.device).wait_stream(source)
