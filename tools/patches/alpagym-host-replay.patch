diff --git a/packages/runtime/src/alpagym_runtime/host_replay.py b/packages/runtime/src/alpagym_runtime/host_replay.py
new file mode 100644
--- /dev/null
+++ b/packages/runtime/src/alpagym_runtime/host_replay.py
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Immutable host snapshots for saved replay, never live inference inputs."""
+
+from dataclasses import fields, is_dataclass, replace
+from typing import Any
+
+import torch
+
+
+def host_snapshot(value: Any) -> Any:
+    """Preserve every tensor value/dtype without first cloning CUDA storage."""
+    if isinstance(value, torch.Tensor):
+        return value.detach().to(device="cpu", copy=True)
+    if is_dataclass(value) and not isinstance(value, type):
+        return replace(value, **{
+            item.name: host_snapshot(getattr(value, item.name)) for item in fields(value)
+        })
+    if isinstance(value, dict):
+        return {key: host_snapshot(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [host_snapshot(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(host_snapshot(item) for item in value)
+    return value
diff --git a/packages/runtime/src/alpagym_runtime/inference_capture.py b/packages/runtime/src/alpagym_runtime/inference_capture.py
new file mode 100644
--- /dev/null
+++ b/packages/runtime/src/alpagym_runtime/inference_capture.py
@@ -0,0 +1,109 @@
+"""Bounded host observations for reconstructing a failed native inference batch.
+
+Only compressed simulator images and Python pose/route metadata are copied.
+No CUDA tensors are read, synchronized, decoded, or modified here.
+"""
+from collections import deque
+from dataclasses import asdict, replace
+import hashlib
+import json
+import os
+from pathlib import Path
+import threading
+
+import torch
+
+
+def capture_root():
+    value = os.environ.get("ALPAGYM_INFERENCE_CAPTURE_DIR")
+    if not value:
+        return None
+    path = Path(value) / str(os.getpid())
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def atomic_json(path, value):
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(value, indent=2) + "\n")
+    os.replace(temporary, path)
+
+
+class HostInputCapture:
+    def __init__(self, session_uuid, frame_capacity):
+        self.root = capture_root()
+        self.session_uuid = session_uuid
+        self.frames = {}
+        self.frame_capacity = frame_capacity
+        self.path = None
+        if self.root is not None:
+            # Never let external session identifiers become filesystem paths.
+            name = hashlib.sha256(session_uuid.encode()).hexdigest()
+            self.path = self.root / f"session-{name}.pt"
+
+    def record(self, policy_input, previous_poses, seed, config):
+        if self.path is None:
+            return None
+        for image in policy_input.camera_images:
+            self.frames.setdefault(image.logical_id, deque(maxlen=self.frame_capacity)).append(image)
+        cameras = tuple(image for ring in self.frames.values() for image in ring)
+        # Native ingestion trims the ego deque to this same capacity. Retain
+        # the original ordered history to preserve strict timestamp validation.
+        from alpagym_runtime.types import Trajectory
+        snapshot = replace(policy_input, camera_images=cameras,
+                           ego_trajectory=Trajectory(previous_poses + policy_input.ego_trajectory.poses))
+        payload = {"policy_input": asdict(snapshot), "session_uuid": self.session_uuid,
+                   "seed": seed, "model_config": json.loads(json.dumps(asdict(config), default=str)),
+                   "format": "native_host_policy_input_v1"}
+        temporary = self.path.with_suffix(".tmp")
+        torch.save(payload, temporary)
+        os.replace(temporary, self.path)
+        return {"path": str(self.path), "session_uuid": self.session_uuid,
+                "step_index": policy_input.step_index, "time_now_us": policy_input.time_now_us,
+                "sha256": hashlib.sha256(self.path.read_bytes()).hexdigest()}
+
+    def close(self):
+        if self.path is not None:
+            self.path.unlink(missing_ok=True)
+        self.frames.clear()
+
+
+def record_dispatch(identities, status):
+    root = capture_root()
+    if root is None:
+        return
+    # One dispatcher writes per process. Session files remain unchanged while
+    # their policies await these futures. On fatal failure, os._exit preserves
+    # the inflight manifest and its exact ordered session snapshots.
+    atomic_json(root / "dispatch.json", {
+        "status": status, "ordered_requests": identities,
+        "thread": threading.current_thread().name,
+        "limitation": "Host inputs require original native GPU preprocessing; not raw CUDA model tensors.",
+    })
+
+
+def restore_policy_input(payload):
+    """Rebuild only the typed host input; native preprocessing remains unchanged."""
+    from alpagym_runtime.types import (
+        CameraCalibration, CameraImage, CameraIntrinsics, EgoPose,
+        PolicyInput, Pose, Quaternion, RouteWaypoint, Trajectory, Vec3,
+    )
+
+    def pose(value):
+        return Pose(Vec3(**value["vec"]), Quaternion(**value["quat"]))
+
+    value = payload["policy_input"]
+    calibration = tuple(CameraCalibration(
+        name=item["name"], logical_id=item["logical_id"],
+        intrinsics=CameraIntrinsics(**item["intrinsics"]) if item["intrinsics"] else None,
+        extrinsic_pose=pose(item["extrinsic_pose"]) if item["extrinsic_pose"] else None,
+    ) for item in value["calibration"])
+    return PolicyInput(
+        step_index=value["step_index"], time_now_us=value["time_now_us"],
+        time_query_us=value["time_query_us"],
+        camera_images=tuple(CameraImage(**item) for item in value["camera_images"]),
+        ego_trajectory=Trajectory(tuple(EgoPose(item["timestamp_us"], pose(item["pose"]))
+                                       for item in value["ego_trajectory"]["poses"])),
+        route_waypoints=tuple(RouteWaypoint(**item) for item in value["route_waypoints"]),
+        route_timestamp_us=value["route_timestamp_us"], calibration=calibration,
+    )
diff --git a/packages/runtime/src/alpagym_runtime/scatter_diagnostics.py b/packages/runtime/src/alpagym_runtime/scatter_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/packages/runtime/src/alpagym_runtime/scatter_diagnostics.py
@@ -0,0 +1,125 @@
+"""Explicit, bounded operator attribution for diagnostic gameplay only."""
+
+from contextlib import contextmanager
+import logging
+import os
+import threading
+import time
+
+import torch
+from torch.utils._python_dispatch import TorchDispatchMode
+
+from alpagym_runtime.inference_capture import atomic_json, capture_root
+
+logger = logging.getLogger(__name__)
+
+
+class ScatterDiagnostics(TorchDispatchMode):
+    """Thread-local dispatcher observer; never replaces a global torch function."""
+
+    def __init__(self, root):
+        super().__init__()
+        self.root = root
+        self.index = 0
+        self.started_ns = time.time_ns()
+
+    def __torch_dispatch__(self, func, types, args=(), kwargs=None):
+        kwargs = kwargs or {}
+        if func not in (
+            torch.ops.aten.masked_scatter.default,
+            torch.ops.aten.masked_scatter_.default,
+        ):
+            return func(*args, **kwargs)
+        tensor, mask, source = args[:3]
+        self.index += 1
+        import traceback
+
+        record = {
+            "diagnostic": "synchronous_scatter_attribution_v1",
+            "dispatch_started_ns": self.started_ns,
+            "operator_index": self.index,
+            "operator": str(func),
+            "thread": threading.current_thread().name,
+            "input_shape": list(tensor.shape),
+            "mask_shape": list(mask.shape),
+            "source_shape": list(source.shape),
+            "source_numel": source.numel(),
+            "device": str(tensor.device),
+            "stream": torch.cuda.current_stream(tensor.device).cuda_stream
+            if tensor.is_cuda
+            else None,
+            "stack": traceback.format_stack(limit=12),
+            "stage": "before_count",
+            "limitation": "Count readback and stream synchronization alter timing; passing is not a production correctness claim.",
+        }
+        # Preserve current dispatch identities before another dispatch can overwrite them.
+        import json
+
+        dispatch = self.root / "dispatch.json"
+        if dispatch.is_file():
+            record["dispatch"] = json.loads(dispatch.read_text())
+        path = self.root / "scatter-inflight.json"
+        atomic_json(path, record)
+        started = time.monotonic()
+        try:
+            selected = int(torch.broadcast_to(mask, tensor.shape).sum().cpu().item())
+            record.update(
+                stage="before_operator",
+                selected_elements=selected,
+                enough_source=selected <= source.numel(),
+            )
+            atomic_json(path, record)
+            # The original primitive executes unchanged, even for malformed input.
+            result = func(*args, **kwargs)
+            record["stage"] = "operator_enqueued"
+            atomic_json(path, record)
+            if tensor.is_cuda:
+                torch.cuda.current_stream(tensor.device).synchronize()
+            record.update(
+                stage="operator_completed", elapsed_seconds=time.monotonic() - started
+            )
+            atomic_json(path, record)
+            atomic_json(self.root / "scatter-last-completed.json", record)
+            return result
+        except BaseException as error:
+            record.update(
+                failed_stage=record["stage"],
+                stage="failed",
+                error_type=type(error).__name__,
+                error=str(error),
+                elapsed_seconds=time.monotonic() - started,
+            )
+            atomic_json(path, record)
+            atomic_json(self.root / "scatter-failure.json", record)
+            raise
+
+
+@contextmanager
+def scatter_diagnostics():
+    """Activate only inside the inference thread and only under explicit opt-in."""
+    enabled = os.environ.get("ALPAGYM_SCATTER_DIAGNOSTICS", "0")
+    if enabled == "0":
+        yield
+        return
+    if enabled != "1":
+        raise ValueError("ALPAGYM_SCATTER_DIAGNOSTICS must be 0 or 1")
+    root = capture_root()
+    if root is None:
+        raise ValueError("Scatter diagnostics require ALPAGYM_INFERENCE_CAPTURE_DIR")
+    marker = root / "scatter-mode.json"
+    if not marker.exists():
+        logger.warning(
+            "Scatter diagnostic mode active: synchronous count readback and per-operator CUDA stream synchronization alter timing and add overhead; this is not a production fix"
+        )
+        atomic_json(
+            marker,
+            {
+                "enabled": True,
+                "mode": "synchronous_scatter_attribution_v1",
+                "thread": threading.current_thread().name,
+                "bounded_files": True,
+                "performance_representative": False,
+            },
+        )
+    with ScatterDiagnostics(root):
+        yield
