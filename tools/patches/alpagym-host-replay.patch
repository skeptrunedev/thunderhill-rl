diff --git a/packages/runtime/src/alpagym_runtime/host_replay.py b/packages/runtime/src/alpagym_runtime/host_replay.py
new file mode 100644
index 0000000..1edd119
--- /dev/null
+++ b/packages/runtime/src/alpagym_runtime/host_replay.py
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Immutable host snapshots for saved replay, never live inference inputs."""
+
+from dataclasses import fields, is_dataclass, replace
+from typing import Any
+
+import torch
+
+
+def host_snapshot(value: Any) -> Any:
+    """Preserve every tensor value/dtype without first cloning CUDA storage."""
+    if isinstance(value, torch.Tensor):
+        return value.detach().to(device="cpu", copy=True)
+    if is_dataclass(value) and not isinstance(value, type):
+        return replace(value, **{
+            item.name: host_snapshot(getattr(value, item.name)) for item in fields(value)
+        })
+    if isinstance(value, dict):
+        return {key: host_snapshot(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [host_snapshot(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(host_snapshot(item) for item in value)
+    return value
